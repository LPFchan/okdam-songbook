# Copy this file to songbook.env on OCI and set only deployment-specific
# values. Keep this file out of git. Do not put secrets in compose.yaml.
#
# The Compose file supplies these fixed in-container paths:
#   DATABASE_PATH=/var/lib/songbook/songbook.sqlite
#   ASSETS_ROOT=/app/apps/web/dist

# Required by apps/server/src/main.ts. Set the public origin including scheme.
ORIGIN=https://songbook.example.invalid
# JSON array of the current allowlisted email addresses.
ALLOWED_USERS_JSON=["allowed@example.invalid"]

# Better Auth signing secret; use at least 32 random characters.
BETTER_AUTH_SECRET=

# Optional Google OAuth credentials. Leave both empty to disable Google login
# during local packaging tests; production auth provisioning must set both.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Korean-reading generation. Set all three together or leave all
# three empty. AI_ENDPOINT is the full OpenAI-compatible chat-completions URL.
AI_ENDPOINT=
AI_MODEL=
AI_API_KEY=
