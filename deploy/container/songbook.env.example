# Copy this file to songbook.env on OCI and set only deployment-specific
# values. Keep this file out of git. Do not put secrets in compose.yaml.
#
# Better Auth / Google OAuth / MCP credentials belong here when the server
# implementation declares their names. Leave unspecified values absent rather
# than inventing credentials in this template.

# SONGBOOK_GOOGLE_CLIENT_ID=
# SONGBOOK_GOOGLE_CLIENT_SECRET=
# BETTER_AUTH_SECRET=
# SONGBOOK_MCP_ISSUER=
