# Copy to /etc/songbook/backup.env with mode 0600. Do not commit real values.
SONGBOOK_DB=/var/lib/songbook/songbook.sqlite
SONGBOOK_BACKUP_DIR=/var/backups/songbook
SONGBOOK_BACKUP_PREFIX=songbook
SONGBOOK_RETENTION_DAYS=30
SONGBOOK_MIN_FREE_KIB=1048576
# SONGBOOK_OFFSITE_HOOK=/etc/songbook/offsite-backup-hook
# SONGBOOK_OFFSITE_REQUIRED=1
