{
  "name": "songbook",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/shared",
    "integrations/chatgpt-proxy",
    "apps/server",
    "packages/server-core",
    "packages/songbook-mcp",
    "packages/songbook-admin"
  ],
  "scripts": {
    "dev": "npm run dev -w @songbook/web",
    "build:runtime": "npm run build -w @songbook/shared && npm run build -w @songbook/server-core && npm run build -w @songbook/mcp && npm run build -w @songbook/admin",
    "build:ordered": "npm run build:runtime && npm run build -w @songbook/server && npm run build -w @songbook/web && npm run build -w @songbook/chatgpt-proxy",
    "pretest": "npm run build:runtime",
    "lint": "npm run lint --workspaces --if-present",
    "pretypecheck": "npm run build:runtime",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build:ordered",
    "verify": "npm run typecheck && npm test && npm run lint && npm run build"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.5.4",
    "vitest": "^4.1.9"
  }
}
